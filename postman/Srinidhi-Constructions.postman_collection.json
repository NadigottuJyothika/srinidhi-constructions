{
  "info": { "name": "Srinidhi Constructions API", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json" },
  "variable": [{"key":"baseUrl","value":"http://localhost:8000/api/index.php"}],
  "item": [
    {"name":"Public projects","request":{"method":"GET","url":"{{baseUrl}}/projects"}},
    {"name":"Public services","request":{"method":"GET","url":"{{baseUrl}}/services"}},
    {"name":"Customer authentication","item":[
      {"name":"Customer CSRF token","event":[{"listen":"test","script":{"type":"text/javascript","exec":["const payload = pm.response.json();","pm.test('CSRF token returned', () => pm.expect(payload.data.csrfToken).to.be.a('string'));","pm.collectionVariables.set('customerCsrf', payload.data.csrfToken);"]}}],"request":{"method":"GET","url":"{{baseUrl}}/customers/csrf"}},
      {"name":"Customer register","event":[{"listen":"test","script":{"type":"text/javascript","exec":["const payload = pm.response.json();","pm.test('Created with customer session and CSRF token', () => { pm.response.to.have.status(201); pm.expect(payload.data.customer.id).to.be.a('number'); pm.expect(payload.data.customer).not.to.have.property('password'); });","pm.collectionVariables.set('customerCsrf', payload.data.csrfToken);"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"X-CSRF-Token","value":"{{customerCsrf}}"}],"body":{"mode":"raw","raw":"{\"name\":\"Sample Customer\",\"email\":\"customer@example.com\",\"phone\":\"+918000000000\",\"password\":\"replace-with-a-local-test-password\"}"},"url":"{{baseUrl}}/customers/register"}},
      {"name":"Customer login","event":[{"listen":"test","script":{"type":"text/javascript","exec":["const payload = pm.response.json();","pm.test('Customer login succeeds without exposing password', () => { pm.response.to.have.status(200); pm.expect(payload.data.customer).not.to.have.property('password'); });","pm.collectionVariables.set('customerCsrf', payload.data.csrfToken);"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"X-CSRF-Token","value":"{{customerCsrf}}"}],"body":{"mode":"raw","raw":"{\"email\":\"customer@example.com\",\"password\":\"replace-with-a-local-test-password\"}"},"url":"{{baseUrl}}/customers/login"}},
      {"name":"Customer session (me)","request":{"method":"GET","url":"{{baseUrl}}/customers/me"}},
      {"name":"Customer logout","event":[{"listen":"test","script":{"type":"text/javascript","exec":["const payload = pm.response.json();","pm.test('Customer session ended and CSRF token rotated', () => { pm.response.to.have.status(200); pm.expect(payload.data.csrfToken).to.be.a('string'); });","pm.collectionVariables.set('customerCsrf', payload.data.csrfToken);"]}}],"request":{"method":"POST","header":[{"key":"X-CSRF-Token","value":"{{customerCsrf}}"}],"url":"{{baseUrl}}/customers/logout"}}
    ]},
    {"name":"Submit enquiry","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"name\":\"Test Visitor\",\"email\":\"visitor@example.com\",\"phone\":\"+918000000000\",\"message\":\"Please contact me about a home project.\"}"},"url":"{{baseUrl}}/enquiries"}},
    {"name":"Admin login","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"email\":\"admin@example.com\",\"password\":\"replace-with-local-password\"}"},"url":"{{baseUrl}}/login"}},
    {"name":"Dashboard (auth)","request":{"method":"GET","url":"{{baseUrl}}/dashboard"}},
    {"name":"Admin enquiries (auth)","request":{"method":"GET","url":"{{baseUrl}}/enquiries"}},
    {"name":"Close enquiry (auth)","request":{"method":"PUT","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"status\":\"Closed\"}"},"url":"{{baseUrl}}/enquiries/1"}},
    {"name":"Delete project (auth)","request":{"method":"DELETE","url":"{{baseUrl}}/projects/1"}},
    {"name":"Logout","request":{"method":"POST","url":"{{baseUrl}}/logout"}}
  ]
}
